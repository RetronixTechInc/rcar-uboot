/dts-v1/;
#include "r8a779g0-sparrowhawk-cpu.dtsi"

/ {
	model = "Renesas Sparrow Hawk board based on r8a779g0";
	compatible = "renesas,sparrowhawk-breakout", "renesas,sparrowhawk-cpu", "renesas,r8a779g0";

	aliases {
		ethernet0 = &avb0;
	};

	reserved-memory {
                #address-cells = <2>;
                #size-cells = <2>;
                ranges;

		cr_region: linux,cr_region@60000000 {
			no-map;
			reg = <0x00000000 0x60000000 0x0 0x20000000>;
		};

		ecc_data_region@4d0000000 {
			no-map;
			reg = <0x4 0xd0000000 0x0 0x30000000>;
		};

		ecc_data_region@6b0000000 {
			no-map;
			reg = <0x6 0xb0000000 0x0 0x50000000>;
		};
	};
};

&avb0 {
	pinctrl-0 = <&avb0_pins>;
	pinctrl-names = "default";
	phy-handle = <&phy0>;
	tx-internal-delay-ps = <2000>;
	status = "okay";

	phy0: ethernet-phy@0 {
		compatible = "ethernet-phy-id0022.1622",
			     "ethernet-phy-ieee802.3-c22";
		rxc-skew-ps = <1500>;
		reg = <0>;
		interrupt-parent = <&gpio7>;
		interrupts = <5 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpio7 10 GPIO_ACTIVE_LOW>;
	};
};

&i2c0 {
	eeprom@51 {
		compatible = "rohm,br24g01", "atmel,24c01";
		label = "breakout-board";
		reg = <0x51>;
		pagesize = <8>;
	};
};

&pfc {
	avb0_pins: avb0 {
		mux {
			groups = "avb0_link", "avb0_mdio", "avb0_rgmii",
				 "avb0_txcrefclk";
			function = "avb0";
		};

		pins_mdio {
			groups = "avb0_mdio";
			drive-strength = <21>;
		};

		pins_mii {
			groups = "avb0_rgmii";
			drive-strength = <21>;
		};

		pins-vddq18-25-avb {
			pins = "GP_4_0", "GP_5_0", "GP_6_0", "GP_7_0";
			power-source = <1800>;
		};
	};
};

&gpio1 {
	pwm-fan-hog {
		gpio-hog;
		gpios = <15 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "PWM-FAN";
	};
};
