/dts-v1/;
#include "r8a779g0-raptor-cpu.dtsi"

/ {
	model = "Renesas Raptor board based on r8a779g0";
	compatible = "renesas,raptor-cpu", "renesas,r8a779g0";

	aliases {
		ethernet0 = &avb0;
	};

	reserved-memory {
                #address-cells = <2>;
                #size-cells = <2>;
                ranges;

		cr_region: linux,cr_region@60000000 {
			no-map;
			reg = <0x00000000 0x60000000 0x0 0x20000000>;
		};
	};
};

&pfc {
    i2c3_pins: i2c3 {
		groups = "i2c3";
		function = "i2c3";
	};
	
	avb0_pins: avb0 {
		mux {
			groups = "avb0_link", "avb0_mdio", "avb0_rgmii",
				 "avb0_txcrefclk";
			function = "avb0";
		};

		pins_mdio {
			groups = "avb0_mdio";
			drive-strength = <21>;
		};

		pins_mii {
			groups = "avb0_rgmii";
			drive-strength = <21>;
		};

	};
};

&avb0 {
	pinctrl-0 = <&avb0_pins>;
	pinctrl-names = "default";
	phy-handle = <&phy0>;
	tx-internal-delay-ps = <2000>;
	status = "okay";

	phy0: ethernet-phy@0 {
		compatible = "ethernet-phy-id0022.1622",
			     "ethernet-phy-ieee802.3-c22";
		rxc-skew-ps = <1500>;
		reg = <0>;
		interrupt-parent = <&gpio7>;
		interrupts = <5 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpio7 10 GPIO_ACTIVE_LOW>;
	};
};

/*
 * I2C3 Function :
 * enable i2c3 and define eeprom
 */
&i2c3 {
    pinctrl-0 = <&i2c3_pins>;
	pinctrl-names = "default";

	status = "okay";
	clock-frequency = <400000>;
	
	eeprom@53 {
		compatible = "rohm,br24g01", "atmel,24c01";
		label = "carrier-board";
		reg = <0x53>;
		pagesize = <8>;
	};
};


